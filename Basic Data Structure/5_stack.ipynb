     "text": [
      "5\n",
      "[1, 2, 3, 4, 5]\n",
      "top element : 5\n"
     ]
    }
   ],
   "source": [
    "stack =[]\n",
    "\n",
    "# stack e push\n",
    "stack.append(1)\n",
    "stack.append(2)\n",
    "stack.append(3)\n",
    "stack.append(4)\n",
    "stack.append(5)\n",
    "\n",
    "print(len(stack))\n",
    "print(stack)\n",
    "\n",
    "print(f\"top element : {stack[-1]}\")\n",
    "\n"
   ]
  },
